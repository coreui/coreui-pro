{
  "color": {
    "palette": {
      "gray": { "$value": "#adb5bd" }
    },
    "theme": {
      "primary": { "base": { "$value": "#0d6efd" } },
      "secondary": { "base": { "$value": "#6c757d" } },
      "success": { "base": { "$value": "#198754" } },
      "info": { "base": { "$value": "#0dcaf0" } },
      "warning": { "base": { "$value": "#ffc107" } },
      "danger": { "base": { "$value": "#dc3545" } },
      "inverse": { "base": { "$value": { "light": "#212529", "dark": "#f8f9fa" } } }
    },
    "fg": {
      "body": { "$value": { "light": "#212529", "dark": "#dee2e6" } },
      "1": { "$value": { "light": "color-mix(in oklch, var(--#{$prefix}gray-900) 85%, transparent)", "dark": "color-mix(in oklch, var(--#{$prefix}gray-300) 85%, transparent)" } },
      "2": { "$value": { "light": "color-mix(in oklch, var(--#{$prefix}gray-900) 75%, transparent)", "dark": "color-mix(in oklch, var(--#{$prefix}gray-300) 75%, transparent)" } },
      "3": { "$value": { "light": "color-mix(in oklch, var(--#{$prefix}gray-900) 50%, transparent)", "dark": "color-mix(in oklch, var(--#{$prefix}gray-300) 50%, transparent)" } },
      "4": { "$value": { "light": "color-mix(in oklch, var(--#{$prefix}gray-900) 25%, transparent)", "dark": "color-mix(in oklch, var(--#{$prefix}gray-300) 25%, transparent)" } }
    }
  },
  "$tokens": {
    "gray-025": "#fdfdfe",
    "gray-050": "#fbfcfc",
    "gray-100": "#f8f9fa",
    "gray-200": "#e9ecef",
    "gray-300": "#dee2e6",
    "gray-400": "#ced4da",
    "gray-500": "#adb5bd",
    "gray-600": "#6c757d",
    "gray-700": "#495057",
    "gray-800": "#343a40",
    "gray-900": "#212529"
  }
}
